# Flask configuration. Use a long random value outside local development.
SECRET_KEY=
DEVELOPMENT=true
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
PORT=5001
DATABASE_PATH=

# Optional n8n integration. N8N_SHARED_SECRET remains supported for compatibility.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
UTILITYOPS_CALLBACK_URL=
N8N_TIMEOUT_SECONDS=4

# Reserved for the disconnected extraction prototype; no OCR is run by the app.
AI_MODE=demo
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
